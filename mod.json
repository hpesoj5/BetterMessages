{
	"geode": "5.7.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "hpesoj5.bettermessages",
	"name": "BetterMessages",
	"version": "v1.0.0-beta.4",
	"developer": "hpesoj5",
	"description": "Improves the message system in Geometry Dash!",
	"tags": ["universal", "enhancement", "interface"],
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"alk.better-touch-prio": ">=1.0.17"
	},
	"settings": {
		"sendMessage": {
			"type": "keybind",
			"name": "Send",
			"default": "Enter",
			"allow-in-text-inputs": true
		},
		"toggleChat": {
			"type": "keybind",
			"name": "Toggle Chat Interface",
			"default": "F9",
			"allow-in-text-inputs": true
		}
	}
}
